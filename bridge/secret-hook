#!/bin/sh
# The PreToolUse hook TGXCode gives each session it starts, for Bash. Most
# commands mention no variable and no secrets path, and those are let through
# here without starting node: the hook runs before every Bash call, and a node
# start on each would be paid on all of them. The rest go to secret-hook.js,
# which decides; bridge/secrets.js says why any of this exists.
#
# $1 is the node that started the session, passed by the bridge: the agent's
# PATH may have none.
input=$(cat)
case $input in
    *'$'*|*secrets*) printf '%s' "$input" | exec "${1:-node}" "$(dirname "$0")/secret-hook.js" ;;
esac
exit 0
