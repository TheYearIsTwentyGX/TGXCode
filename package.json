{
  "name": "claude-sessions",
  "version": "1.0.0",
  "description": "Manage Claude Code sessions running in WSL2 from a Windows desktop app",
  "main": "app/main.js",
  "author": "Dylan Hays",
  "private": true,
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node scripts/dev.js",
    "dev:headless": "node scripts/dev.js --no-window",
    "bridge": "node bridge/server.js",
    "build": "node scripts/build.js",
    "icon": "node app/make-icon.js --preview",
    "dist": "electron-builder"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^31.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.claudesessions.desktop",
    "productName": "ClaudeSessions",
    "files": [
      "app/**/*",
      "package.json"
    ],
    "win": {
      "icon": "app/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    }
  }
}
